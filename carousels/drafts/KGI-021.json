  "web": {
    "title": "Baraat Freeze: Shaadi Season Kitty Party Game Rules and Twists",
    "description": "Baraat Freeze is a shaadi season kitty party dance game: dance to baraat songs, then form groups of the called wedding pose in 5 seconds. Rules, steps and FAQ.",
    "intro": "Baraat Freeze is a musical grouping game for kitty parties where everyone dances to a baraat song and, when the music stops, forms groups of the exact size the host calls (Varmala = 2, Joota Chupai = 3, Phere = 4, Family Photo = 6) within 5 seconds. Anyone left without a group, or standing in a group of the wrong size, is out, and the last lady standing wins. The crazy twist: when the host shouts \"Mascot aa gaya!\", the last lady out walks through the dancers in slow motion and anyone who laughs is out too. It needs nothing but a phone speaker and some open floor, so it is perfect for a shaadi season or wedding theme kitty.",
    "players": "8 to 20",
    "time": "10 to 15 minutes",
    "materials": [
      "A phone or Bluetooth speaker with a few baraat and sangeet songs",
      "Open floor space, with the centre table and sofa pushed to the side",
      "Optional: small chits listing the poses and their headcounts for the host"
    ],
    "steps": [
      "The host explains the poses and their headcounts: Varmala = 2, Joota Chupai = 3, Phere = 4, Family Photo = 6.",
      "Play a baraat song and everyone dances freely around the room like the groom's friends in a baraat.",
      "The host stops the music and loudly calls one pose, for example \"Phere! Chaar chaar!\".",
      "Within 5 seconds every lady must join a group of exactly that many people, hold hands and strike the pose.",
      "Anyone left alone, and any group with too many or too few ladies, is out and sits on the sofa.",
      "Now and then the host shouts \"Mascot aa gaya!\": the last lady who went out walks through the dancers in slow motion, and anyone who laughs is out too.",
      "Keep playing until two ladies remain; they do a final Varmala pose and win."
    ],
    "rules": [
      "A group must have exactly the called headcount; one extra or one short and the whole group is out.",
      "Anyone who joins a group after the 5 second count is out as a late baraati.",
      "During the mascot walk, anyone who laughs or smiles widely is out.",
      "The last lady standing, or the final pair, wins the game."
    ],
    "variations": [
      "On \"Dhol!\" every group must make one member the dholwali, miming the dhol while the rest dance around her in the frozen pose.",
      "For big groups, call \"Asli phere!\", which means a group of 7, just like the seven real phere.",
      "On \"Dulhan aa gayi!\" everyone freezes in a shy bride pose instead of grouping, and anyone who moves is out."
    ],
    "tips": [
      "When fewer ladies remain, call smaller headcounts like 2 or 3 so the game keeps moving.",
      "Clear glass items and side tables from the floor before you start dancing.",
      "Keep the songs loud and peppy, like popular baraat and sangeet numbers.",
      "Let the ladies who are out be the judges who spot wrong group sizes and laughers."
    ],
    "faq": [
      {
        "q": "How many players do you need for Baraat Freeze?",
        "a": "It works best for 8 to 20 ladies. With fewer than 8, use only the 2 and 3 headcounts."
      },
      {
        "q": "What do you need to play Baraat Freeze at a kitty party?",
        "a": "Only a phone speaker with a few baraat songs and some open floor space. Pose chits for the host are optional."
      },
      {
        "q": "How do you win Baraat Freeze?",
        "a": "Stay in a correctly sized group every round and do not laugh at the mascot. The last lady or final pair left standing wins."
      },
      {
        "q": "Is Baraat Freeze good for a wedding theme kitty party?",
        "a": "Yes. Every pose is a shaadi moment and the music is baraat songs, so it fits shaadi season, sangeet or wedding theme kitties perfectly."
      },
      {
        "q": "Is Baraat Freeze suitable for older ladies?",
        "a": "Yes. The dancing can be as gentle as anyone likes, and the only real challenge is grouping quickly and keeping a straight face."
      }
    ]
  }
}
