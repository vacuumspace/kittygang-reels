  "web": {
    "title": "Shaadi Akshar: Wedding Letter Game for Kitty Parties",
    "description": "Shaadi Akshar is a wedding word game for kitty parties: pick a letter with a bangle, write 5 shaadi answers in 60 seconds. Rules, scoring, twists and FAQ.",
    "intro": "Shaadi Akshar is a pen and paper word game for kitty parties where a bangle thrown on an A to Z chart picks a letter, and every lady has 60 seconds to write a wedding rasam, a sangeet gaana, a shaadi menu dish, a piece of jewellery and a relative starting with that letter. Unique answers score 2 points, answers someone else also wrote score 1, and the highest total after 3 letters wins. The crazy twist: to keep her gaana point, each lady must sing one line of her song to the whole room. It needs only paper, pens and one bangle, so it is an easy shaadi season kitty game for any home.",
    "players": "8 to 20",
    "time": "15 minutes",
    "materials": [
      "One sheet of chart paper with an A to Z grid (26 boxes, one letter each)",
      "One plastic or metal bangle",
      "A sheet of paper and a pen for every lady",
      "A phone timer"
    ],
    "steps": [
      "Draw a 6 by 5 grid on chart paper and write one letter from A to Z in each box. Lay it on the floor or a table.",
      "The host throws a bangle onto the chart. The letter where it lands (or mostly covers) is the letter for this round.",
      "Start a 60 second timer. Every lady writes one answer for each of the 5 categories, all starting with that letter: rasam (ritual), gaana (wedding song), khaana (shaadi menu dish), gehna (jewellery) and rishtedaar (relative).",
      "When time is up, go around the room and read the answers. An answer nobody else wrote scores 2 points, an answer shared with anyone scores 1, a blank scores 0.",
      "For the gaana point, the lady must sing one line of her song to the room. Play 3 letters and add up the totals."
    ],
    "rules": [
      "Anything written after the timer ends does not count.",
      "An answer that does not start with the letter, or a blank, scores zero.",
      "If you do not sing your gaana line, you lose the gaana point.",
      "The highest total after 3 rounds wins and is crowned Shaadi Ki Rani."
    ],
    "variations": [
      "Add a sixth category: the worst dish you ever ate at a shaadi.",
      "When the host shouts \"Baraat aa gayi!\", the timer for that round drops to 30 seconds.",
      "Jodi round: saas and bahu pairs, or best friends, fill one sheet together."
    ],
    "tips": [
      "Cross out Q, X and Z on the chart before you start; they are too hard.",
      "Let the group agree on doubtful answers by a quick show of hands.",
      "Keep one person as scorer so reading answers stays fast.",
      "Throw the bangle from a little distance so the letter feels like luck."
    ],
    "faq": [
      {
        "q": "How many players do you need for Shaadi Akshar?",
        "a": "It works for 8 to 20 ladies. Everyone writes at the same time, so a big group does not slow it down."
      },
      {
        "q": "What do you need to play this kitty party word game?",
        "a": "Chart paper with an A to Z grid, one bangle, paper and a pen for each lady, and a phone timer."
      },
      {
        "q": "How is Shaadi Akshar scored?",
        "a": "An answer nobody else wrote gets 2 points, an answer shared with others gets 1, and a blank or wrong letter gets 0. The gaana point counts only if you sing a line."
      },
      {
        "q": "Is Shaadi Akshar good for a wedding theme or shaadi season kitty?",
        "a": "Yes. All five categories are about weddings, so it fits a shaadi theme, bridal shower or any kitty in the wedding season."
      },
      {
        "q": "Can older ladies and non-singers play?",
        "a": "Yes. Anyone can write the answers. Non-singers can hum or say the line in a sing-song voice, and the room decides if it counts."
      }
    ]
  }
