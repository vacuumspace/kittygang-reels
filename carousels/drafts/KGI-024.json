  "web": {
    "title": "Sangeet Ki Practice: Shaadi Dance Kitty Party Game Rules",
    "description": "Sangeet Ki Practice is a shaadi season kitty party dance memory game: watch 8 sangeet steps once, repeat them in sync as a team. Rules, twists and FAQ.",
    "intro": "Sangeet Ki Practice is a dance memory game for kitty parties where the host shows an 8-step sangeet routine just once and teams of 4 must repeat it in sync to a shaadi song. The team that does all the steps in the right order and most in sync, as scored by the other teams, wins. The crazy twist: whenever the host shouts \"Mamaji aa gaye!\", the left-most lady in the dancing team must add a brand new step of her own, and her team must keep it in every round after. It needs only a phone speaker, so it is perfect for a shaadi season or sangeet theme kitty.",
    "players": "8 to 20 (teams of 4)",
    "time": "15 minutes",
    "materials": [
      "A phone or Bluetooth speaker with a few peppy shaadi and sangeet songs",
      "8 chits listing the steps for the host: Thumka, Bulb lagao, Patang udao, Matki, Ghoonghat, Chutki, Gol ghoomo, Namaste",
      "Each lady's own dupatta for the ghoonghat step",
      "A paper and pen for the scores",
      "Some open floor space"
    ],
    "steps": [
      "Split the ladies into teams of 4 and push the centre table aside.",
      "The host plays a shaadi song and shows the full 8-step routine only once: Thumka, Bulb lagao, Patang udao, Matki, Ghoonghat, Chutki, Gol ghoomo and Namaste. Nobody may write anything down.",
      "One team at a time stands in a line, the song starts, and the four ladies repeat all 8 steps together, in order and in sync.",
      "During any team's turn the host may shout \"Mamaji aa gaye!\". The left-most lady must invent one new step on the spot, and her team must add it to the routine in every round after.",
      "The other teams act as judges and give each team a score out of 10 for correct order and sync.",
      "Play two or three rounds and add up the scores. The team with the highest total wins."
    ],
    "rules": [
      "Every wrong or missing step in the order costs one point.",
      "Forgetting a step added by a \"Mamaji aa gaye!\" call costs two points.",
      "If one lady is clearly ahead or behind the others, the judges cut points for sync.",
      "The team with the highest total score is the sangeet star team."
    ],
    "variations": [
      "On \"Dulhan aa gayi!\" the whole team freezes in a shy ghoonghat pose, and anyone who moves loses a point.",
      "Play each new round to a faster song while the steps stay the same.",
      "In the final round, turn the music off and dance only to the beat of everyone's claps."
    ],
    "tips": [
      "The host should keep the step chits in hand so judging is quick and fair.",
      "Pick simple, well known shaadi steps so ladies of every age can join in.",
      "Ask teams to stand facing the judges so everyone can see the sync clearly.",
      "Keep the dance gentle; gol ghoomo can be a slow turn for anyone who prefers."
    ],
    "faq": [
      {
        "q": "How many players do you need for Sangeet Ki Practice?",
        "a": "It works best for 8 to 20 ladies split into teams of 4. With fewer ladies, play in pairs."
      },
      {
        "q": "What do you need to play Sangeet Ki Practice at a kitty party?",
        "a": "Just a phone speaker with shaadi songs, a few chits listing the 8 steps for the host, and some open floor. A dupatta helps for the ghoonghat step."
      },
      {
        "q": "How do you win Sangeet Ki Practice?",
        "a": "Repeat all the steps in the right order, remember every new Mamaji step, and stay in sync with your team. The highest total score from the judges wins."
      },
      {
        "q": "Is Sangeet Ki Practice good for a shaadi theme kitty party?",
        "a": "Yes. The steps are classic sangeet moves and the music is wedding songs, so it suits shaadi season, sangeet or wedding theme kitties."
      },
      {
        "q": "Is this dance game suitable for older ladies?",
        "a": "Yes. The steps are simple hand and body moves, the pace can be slow, and the real challenge is memory and teamwork, not fancy dancing."
      }
    ]
  }
}
